generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Pillar {
  id            String     @id @default(cuid())
  slug          String     @unique // "maths", "coding", "computing"
  titleEn       String     // e.g. "Mathematics"
  titleFr       String     // e.g. "Mathématiques"
  descriptionEn String?    @db.Text
  descriptionFr String?    @db.Text
  icon          String?
  categories    Category[]
  createdAt     DateTime   @default(now())
}

model Category {
  id            String    @id @default(cuid())
  slug          String    @unique // "high-school", "didactics", "math-for-ai", "dsa", etc.
  titleEn       String    // e.g. "Didactics & Pedagogy"
  titleFr       String    // e.g. "Didactique & Pédagogie"
  descriptionEn String?   @db.Text
  descriptionFr String?   @db.Text
  pillarId      String
  pillar        Pillar    @relation(fields: [pillarId], references: [id], onDelete: Cascade)
  articles      Article[]
  createdAt     DateTime  @default(now())
}

model Article {
  id          String   @id @default(cuid())
  slug        String
  titleEn     String
  titleFr     String
  excerptEn   String?  @db.Text
  excerptFr   String?  @db.Text
  contentEn   String   @db.LongText // Markdown + LaTeX (English)
  contentFr   String   @db.LongText // Markdown + LaTeX (French)
  youtubeUrl  String?
  published   Boolean  @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, slug])
}

enum SchoolLevel {
  COLLEGE_1AC   @map("1ac")
  COLLEGE_2AC   @map("2ac")
  COLLEGE_3AC   @map("3ac")
  TRONC_COMMUN  @map("tronc commun")
  BAC_1         @map("1bac")
  BAC_2         @map("2bac")
}

model QcmExam {
  id               String            @id @default(cuid())
  slug             String            @unique
  title            String
  description      String?           @db.Text
  timeLimitMinutes Int?
  published        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  levels           QcmExamLevel[]
  questions        QcmExamQuestion[]
  attempts         QcmAttempt[]

  @@map("qcmexam")
}

model QcmExamLevel {
  id      String      @id @default(cuid())
  examId  String
  level   SchoolLevel

  exam    QcmExam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, level])
  @@index([level])
  @@map("qcm_exam_levels")
}

model QcmExamQuestion {
  id         String      @id @default(cuid())
  examId     String
  questionId String
  order      Int         @default(1)

  exam       QcmExam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   QcmQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
}

model QcmQuestion {
  id          String            @id @default(cuid())
  topic       String
  difficulty  String
  question    String            @db.Text
  imageUrl    String?
  explanation String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  options     QcmOption[]
  exams       QcmExamQuestion[]
  answers     QcmAnswer[]
}

model QcmOption {
  id         String      @id @default(cuid())
  questionId String
  text       String      @db.Text
  imageUrl   String?
  isCorrect  Boolean     @default(false)

  question   QcmQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    QcmAnswer[]

  @@index([questionId])
}

model Student {
  id                 String       @id @default(cuid())
  fullName           String
  firstName          String?
  lastName           String?
  email              String       @unique
  phone              String?
  level              SchoolLevel?
  passwordHash       String?
  mustChangePassword Boolean      @default(true)
  isActive           Boolean      @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt

  attempts           QcmAttempt[]
  reservations       Reservation[]

  @@index([level])
  @@index([isActive])
}

model QcmAttempt {
  id             String      @id @default(cuid())
  examId         String
  studentId      String
  score          Int
  totalQuestions Int
  percentage     Float
  startedAt      DateTime    @default(now())
  completedAt    DateTime?

  exam           QcmExam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers        QcmAnswer[]

  @@index([examId])
  @@index([studentId])
}

model QcmAnswer {
  id               String      @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean     @default(false)

  attempt          QcmAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         QcmQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QcmOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  category  String
  message   String   @db.Text
  status    String   @default("UNREAD") // UNREAD, READ, ARCHIVED
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

// Configuration d'une semaine spécifique
model WeeklySchedule {
  id          String   @id @default(cuid())
  mondayDate  DateTime @unique // Identifiant unique de la semaine (la date du Lundi)
  matrix      Json     // La grille 7x3 avec les couleurs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Réservation garantie de l'élève
model Reservation {
  id          String   @id @default(cuid())
  studentId   String
  mondayDate  DateTime // Pour retrouver la semaine correspondante
  jour        String   // ex: "Mardi"
  horaire     String   // ex: "19H - 20H30"
  createdAt   DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([mondayDate])
}

// Le modèle permanent de ton emploi du temps
model ScheduleTemplate {
  id        String   @id @default("default") // Il n'y aura toujours qu'une seule ligne
  matrix    Json
  updatedAt DateTime @updatedAt
}